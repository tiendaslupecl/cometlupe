": null, "name": null}], "links": [{"from_step_id": "b9db84f2-8b11-4b7e-b472-433162c188ff", "from_port_id": "output", "to_step_id": "49ee4129-dd7d-407d-bd77-e75de0b6512d", "to_port_id": "input"}, {"from_step_id": "49ee4129-dd7d-407d-bd77-e75de0b6512d", "from_port_id": "output", "to_step_id": "96c0467c-d07f-44e3-b696-5af4f5d1969a", "to_port_id": "input"}], "patched_fields": [], "variables": [], "note": null, "vertical_layout_enabled": true, "workflow_name": "Recuperar carritos abandonados con descuento"}}