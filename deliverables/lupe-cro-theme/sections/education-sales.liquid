<section class="lupe-edu lupe-container" style="padding:0 0 48px">
  <h2 style="margin:0 0 16px;font-size:clamp(22px,3vw,30px)">{{ section.settings.heading }}</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px">
    {% for block in section.blocks %}
      <article class="lupe-card" {{ block.shopify_attributes }}>
        <h3 style="margin:0 0 8px;font-size:18px"><a href="{{ block.settings.url }}" style="color:inherit;text-decoration:none">{{ block.settings.title }}</a></h3>
        <p style="margin:0 0 12px;font-size:14px;color:var(--lupe-muted,#94a3b8)">{{ block.settings.teaser }}</p>
        <a class="lupe-btn lupe-btn--secondary" href="{{ block.settings.url }}" style="width:100%;text-align:center">{{ block.settings.cta }}</a>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Educación + venta",
  "tag": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Título", "default": "Guías que venden" }],
  "blocks": [
    {
      "type": "guide",
      "name": "Guía",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Qué aguja usar en mezclilla" },
        { "type": "textarea", "id": "teaser", "label": "Resumen", "default": "Evita saltos de puntada y roturas. Tabla rápida por tela." },
        { "type": "url", "id": "url", "label": "URL", "default": "/blogs/news" },
        { "type": "text", "id": "cta", "label": "CTA", "default": "Leer guía" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Educación + venta",
      "blocks": [
        { "type": "guide", "settings": { "title": "Agujas por tipo de tela", "teaser": "Mezclilla, denim, elasticados y más.", "url": "/blogs/news", "cta": "Ver tabla" } },
        { "type": "guide", "settings": { "title": "Errores frecuentes en costura", "teaser": "Tensión, hilo y aguja: checklist.", "url": "/blogs/news", "cta": "Corregir ahora" } }
      ]
    }
  ]
}
{% endschema %}
