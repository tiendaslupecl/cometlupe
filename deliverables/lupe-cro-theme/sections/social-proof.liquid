<section class="lupe-proof lupe-container" style="padding:0 0 48px">
  <h2 style="margin:0 0 16px;font-size:clamp(22px,3vw,30px)">{{ section.settings.heading }}</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px">
    {% for block in section.blocks %}
      <figure class="lupe-card" style="margin:0" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.quote | escape | truncate: 80 }}" width="400" height="260" loading="lazy" style="width:100%;height:160px;object-fit:cover;border-radius:10px;margin-bottom:10px">
        {%- endif -%}
        <blockquote style="margin:0 0 10px;font-size:15px;font-weight:600">“{{ block.settings.quote }}”</blockquote>
        <figcaption style="font-size:13px;color:var(--lupe-muted,#94a3b8)">{{ block.settings.author }} · {{ block.settings.role }}</figcaption>
      </figure>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Prueba social",
  "tag": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Título", "default": "Clientes reales" }],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonio",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "textarea", "id": "quote", "label": "Cita", "default": "Stock confiable y despacho rápido para mi taller." },
        { "type": "text", "id": "author", "label": "Nombre", "default": "María R." },
        { "type": "text", "id": "role", "label": "Rol", "default": "Emprendedora" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prueba social",
      "blocks": [
        { "type": "quote", "settings": { "quote": "Encontré repuestos que en otros lados no había.", "author": "Carlos P.", "role": "Taller B2B" } },
        { "type": "quote", "settings": { "quote": "Me asesoraron con la aguja correcta para stretch.", "author": "Daniela S.", "role": "Principiante" } }
      ]
    }
  ]
}
{% endschema %}
