{% doc %}
  Botón flotante WhatsApp — ícono directo sin panel.
  Parámetros: phone (E.164 sin +), brand (nombre tienda)
{% enddoc %}
{%- liquid
  assign wa = phone | default: settings.cro_whatsapp_e164 | default: '56963855857'
  assign base = settings.cro_whatsapp_base | default: 'https://wa.me/'
  assign brand_name = brand | default: shop.name
  assign wa_url = base | append: wa
-%}
<link rel="stylesheet" href="{{ 'cro-whatsapp-float.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'cro-whatsapp-float.css' | asset_url | stylesheet_tag }}</noscript>
<div class="wa-float" data-wa-root>
  <a class="wa-float__toggle" href="{{ wa_url }}" target="_blank" rel="noopener" aria-label="WhatsApp {{ brand_name }}">
    <span class="wa-float__icon" aria-hidden="true">{% render 'icon-whatsapp' %}</span>
  </a>
</div>
