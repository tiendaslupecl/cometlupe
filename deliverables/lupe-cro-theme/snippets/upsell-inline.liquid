{% doc %} Upsell inline bajo producto host: usa colección metafield custom.upsell_collection {% enddoc %}
{%- assign col = host.metafields.custom.upsell_collection.value -%}
{%- if col == blank -%}{% assign col = collections['insumos-confeccion'] %}{%- endif -%}
{%- if col and col.products_count > 0 -%}
  <div style="margin-top:10px;padding-top:10px;border-top:1px solid #e2e8f0">
    <p style="margin:0 0 10px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#16a34a">Completa tu compra</p>
    <div style="display:grid;gap:8px">
      {% for p in col.products limit: 3 %}
        {%- assign first_available_variant = p.selected_or_first_available_variant -%}
        <div style="display:flex;align-items:center;gap:10px">
          <a href="{{ p.url }}" style="flex-shrink:0">
            {%- if p.featured_image -%}
              <img src="{{ p.featured_image | image_url: width: 64 }}" alt="{{ p.featured_image.alt | escape }}" width="52" height="52" style="border-radius:6px;object-fit:cover;display:block" loading="lazy">
            {%- else -%}
              <div style="width:52px;height:52px;border-radius:6px;background:#f1f5f9;display:flex;align-items:center;justify-content:center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
            {%- endif -%}
          </a>
          <div style="flex:1;min-width:0">
            <a href="{{ p.url }}" style="font-size:12px;color:#1a202c;text-decoration:none;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ p.title | truncate: 38 }}</a>
            <span style="font-size:12px;color:#4a5568">{{ first_available_variant.price | money }}</span>
          </div>
          {% if first_available_variant %}
            <form method="post" action="{{ routes.cart_add_url }}" data-lupe-quick-add data-source="upsell_inline" data-product-id="{{ p.id }}" style="flex-shrink:0">
              <input type="hidden" name="id" value="{{ first_available_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" data-lupe-quick-add-btn class="lupe-btn lupe-btn--secondary" style="padding:.35rem .75rem;font-size:12px;white-space:nowrap">Añadir</button>
            </form>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{%- endif -%}
