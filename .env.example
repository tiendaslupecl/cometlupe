SHOP_DOMAIN=0viv7s-w8.myshopify.com
ADMIN_API_TOKEN=PEGA_AQUI_TU_NUEVO_TOKEN

# Opcional: URL publica de la tienda (para submenus con filtros en el menu por GraphQL).
# Si no la pones, el script intenta leerla de Shopify.
# STORE_PRIMARY_URL=https://www.tiendaslupe.cl

# Pagina de contacto en el menu (evita 404 si el handle difiere). Ejemplo: /pages/contacto o /pages/contact
# CONTACT_PAGE_PATH=/pages/contacto

# Si pones 1, no intenta publicar colecciones por API (solo usa Admin manual para publicación).
# SKIP_STORE_PUBLISH=0

# ── Admin API — scopes recomendados (copiar nombres al crear/editar la app en Shopify) ──
# Colecciones / catálogo y SEO:
#   read_products, write_products
# Publicaciones al canal Tienda online (evita 404 si las colecciones no están visibles):
#   read_publications, write_publications
# Contenido y menús / navegación:
#   read_content, write_content
#   read_online_store_navigation, write_online_store_navigation
# Tema / idiomas (según necesidad):
#   read_themes, write_themes   # write_themes: tasks/theme_set_variant_dropdown.py
#   read_locales
#
# Si cambias scopes: Guardar → Instalar de nuevo la app → nuevo Admin API token en este archivo.
#
# Shopify Plus es un plan de pago aparte (no depende de estos scopes). Info: https://www.shopify.com/plus

# --- Otros proyectos en este repo (solo si los usas) ---
# SHOPIFY_API_KEY=your_api_key_here
# SHOPIFY_API_SECRET=your_api_secret_here
# SHOPIFY_API_SCOPES=read_products
# PORT=3000
# NODE_ENV=development
